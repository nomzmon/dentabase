<script>
    const rawAppointmentData = [
        {{#each allAppointmentsData}}
        {
            date: "{{this.date}}", 
            service: "{{this.procedure}}", 
            amount: "{{this.amountCharged}}",
            status: "{{this.status}}"
        }, 
        {{/each}}
    ];
</script>


<!-- NAME PAGE, SEARCH BOX-->
<div class="frame-1">
    <div class="name-page"> Services</div>
    <div class="search-settings-group">
        <form action="/patient_list" method="GET">
            <button type="submit" style="background: none; border: none; padding: 0; cursor: pointer">
                <img class="icon-search" src="/img/icon-search.svg" />
            </button>
            <input name="search" required type="text" class="search-box" placeholder="Search for a Patient" />
        </form>
    </div>

</div>
<!--`END NAME PAGE-->


<!-- `TITLES -->

<div class="frame-2 report-frame2">

    <div class="title-divider"></div>

    <div class="title-group">
        <div class="title-element">Recent Activity</div>


    </div>
    <div class="title-divider-2"></div>
    <div class="indicator-line"></div>

</div>
<!-- `END TITLES -->

<!-- +PATIENT DETAILS-->
<div class="frame-3">
    <div class="dashboard-group">

        <!-- `Card for Appointments -->
        <div class="card">
            <div class="card-header">
                <h3>Monthly Appointments</h3>
            </div>
            <div class="filter-controls-row">
                <!-- Filter Year -->
                <div class="filter-group">
                    <label for="apptYearSelect">Year:</label>
                    <select id="apptYearSelect" name="year">
                    <option value="All">Select</option>
                    {{#each availableYears}}
                        <option value="{{this}}">{{this}}</option>
                    {{/each}}
                    </select>
                </div>
                <!-- Filter by Services -->
                <div class="filter-group">
                    <label for="apptServiceSelect">Service:</label>
                    <select id="apptServiceSelect" name="service">
                        <option value="All">All Services</option>
                        {{#each allServices}}
                            <option value="{{{this.service}}}">{{{this.service}}}</option>
                        {{/each}}
                    </select>
                </div>
                <button id="applyApptFilterBtn" class="action-button" type="button">Filter</button>
            </div>
            <!-- Total Number of Appointments and Chart -->
            <p>Total Appointments: <span id="totalApptCount">{{appointmentCount}}</span></p>
            <div class="chart-container">
                <canvas id="appointmentsChart" class="appointment-chart"></canvas>
            </div>
        </div>
        <!-- `END OF APPOINTMENT CHART-->



        <!-- Card for Revenue -->
        <div class="card">
            <div class="card-header">
                <h3>Monthly Revenue</h3>
            </div>
            <div class="filter-controls-row">
                <!-- Filter Year -->
                <div class="filter-group">
                    <label for="revYearSelect">Year:</label>
                    <select id="revYearSelect" name="year">
                    <option value="All">Select</option>
                    {{#each availableYears}}
                        <option value="{{this}}">{{this}}</option>
                    {{/each}}
                    </select>
                </div>
                <!-- Filter Service -->
                <div class="filter-group">
                    <label for="revServiceSelect">Service:</label>
                    <select id="revServiceSelect" name="service">
                    <option value="All">All Services</option>
                        {{#each allServices}}
                            <option value="{{{this.service}}}">{{{this.service}}}</option>
                        {{/each}}
                    </select>
                </div>
                <button id="applyRevFilterBtn" class="action-button" type="button">Filter</button>
            </div>
            <div class="chart-container">
                <canvas id="revenueChart" class="appointment-chart"></canvas>
            </div>
        </div>
        <!-- `END DASHBOARD GROUP-->
    </div>
</div>

<!--To render the charts-->
<script src="/js/E_Report.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>